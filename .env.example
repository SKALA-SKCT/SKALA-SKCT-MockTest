# Postgres connection string.
# Local: postgres://user@localhost:5432/skct
# Production: Supabase Transaction Pooler URL is recommended for Vercel serverless.
DATABASE_URL=postgres://user:password@localhost:5432/skct

# Set true for Supabase/Vercel production connections.
DATABASE_SSL=false

# Keep low on Vercel/Supabase Free to avoid exhausting database connections.
DB_POOL_MAX=2

# Random long string for signing session cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me

# Only set this locally/temporarily when importing seed data.
# db:import deletes existing exams and cascades attempts/responses.
ALLOW_DB_RESET=false
