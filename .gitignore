# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
__pycache__/
*.pyc

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Local Google Cloud service-account key material
/private-key.pem
/public-key.pem
.claude/
.idea/
tmp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local data/schema artifacts
/data/
/drizzle/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
